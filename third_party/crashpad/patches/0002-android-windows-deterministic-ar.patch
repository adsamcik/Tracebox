+# Copyright 2026 The Tracebox Authors
+# Licensed under the Apache License, Version 2.0.
+
+import os
+import subprocess
+import sys
+
+
+def main() -> int:
+    if len(sys.argv) < 4:
+        return 2
+    archive_tool = sys.argv[1]
+    output = sys.argv[2]
+    if os.path.exists(output):
+        os.unlink(output)
+    subprocess.check_call([archive_tool, "rcsD", output, *sys.argv[3:]])
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
